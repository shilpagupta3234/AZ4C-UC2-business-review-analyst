# Copy this file to .env and add your keys. Never commit .env.
# Read these four values from the environment. Don't hard-code a key or a
# provider address.
#
# Groq: the groq SDK reads GROQ_API_KEY and GROQ_BASE_URL by itself.
#   With an OpenAI-compatible client, use base_url = GROQ_BASE_URL + "/openai/v1".
# Gemini: with google-genai, pass GEMINI_BASE_URL as http_options base_url.
#   With an OpenAI-compatible client, use base_url = GEMINI_BASE_URL + "/v1beta/openai/".
#
# Add any other settings your system needs below, without values.

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Optional. Folder that holds the data pack (data/, docs/). Defaults to the repo root.
DATA_DIR=
# Optional. Where answers and the query log are written. Defaults to code/mock_system.
MOCK_SYSTEM_DIR=

# Optional model overrides. Defaults: orchestrator openai/gpt-oss-120b (Groq) with
# gemini-3.6-flash (Gemini) as fallback; specialists gemini-3.6-flash with
# openai/gpt-oss-20b (Groq) as fallback.
ORCHESTRATOR_MODEL=
ORCHESTRATOR_FALLBACK_MODEL=
SPECIALIST_MODEL=
SPECIALIST_FALLBACK_MODEL=
# Optional limits. Defaults: 30 seconds per model call, 12 model calls per run.
LLM_TIMEOUT_S=
LLM_MAX_CALLS_PER_RUN=
